# 토스증권 OpenAPI (https://developers.tossinvest.com)
# web 대시보드는 이 값이 없어도 뜬다 — 접속자가 상단 '⚙ 설정'에서 각자 키를 넣으면 된다.
# (CLI scan/watch/poll/backtest 에는 필요)
TOSS_CLIENT_ID=tsck_live_xxxxxxxxxxxx
TOSS_CLIENT_SECRET=tssk_live_xxxxxxxxxxxx

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 실거래 (기본 꺼짐 — 켜면 실제 주문이 나갑니다)
TOSS_TRADING_ENABLED=true
TOSS_MAX_ORDER_AMOUNT=1000000
# TOSS_ACCOUNT_SEQ=          # 비우면 첫 번째 계좌를 사용

# 로그인 · 설정 서버 저장 (SQLite: cache/app.db)
# APP_SECRET_KEY: 저장된 client_secret·봇 토큰을 푸는 열쇠. 바꾸면 저장값을 다시 입력해야 한다.
# APP_ADMIN_*   : 첫 실행 때 만들 기본 **관리자** 계정. 이후 `python main.py adduser <아이디> [--admin]`.
APP_SECRET_KEY=change-me
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
# APP_DB_PATH=/app/cache/app.db
# APP_SIGNUP     : 로그인 화면 회원가입 허용 (기본 true). 가입자는 일반 사용자 —
#                  자기 토스 키로만 주문·봇을 쓰고, 서버 계좌(TOSS_*)는 관리자만 쓴다.
# APP_SIGNUP_CODE: 넣으면 이 초대 코드를 아는 사람만 가입할 수 있다 (외부 공개 시 권장).
APP_SIGNUP=true
APP_SIGNUP_CODE=

# 이메일 알림 (Gmail SMTP). 발신 계정은 서버 공용, 수신 주소는 사용자가 설정 창에 입력.
# Gmail 은 2단계 인증 후 "앱 비밀번호"(16자, 공백 포함 가능)를 MAIL_SMTP_PASS 에 넣는다.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_PORT=587
MAIL_SMTP_CRYPTO=tls
MAIL_FROM_NAME=왔니 주식
